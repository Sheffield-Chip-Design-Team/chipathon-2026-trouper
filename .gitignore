# RTL build outputs (source files tracked; run results live on NFS via symlink)
rtl-test/obj_dir*/
rtl-test/out/
rtl-test/*.vcd
rtl-test/ol_*/runs
rtl-test/ol_*/*.log
rtl-test/picorv32_ip/
rtl-test/*status*.txt
rtl-test/tmp_*.tcl

# Synthesis output netlists (regenerable; keep .log/.txt reports)
rtl-test/syn_*/out_*/netlist.v

# Session continuation transcripts
2026-*.txt

characterization/

# Root-level Vivado session logs
vivado*.jou
vivado*.log
updatemem*.jou
updatemem*.log

# P&R config bundle zips (ad-hoc root-level zips, not pd-bundles/)
*.zip

# PD bundles — tarballs in pd/ are intentionally tracked
# Ignore LibreLane run outputs if bundle is extracted and run locally
pd/*/ol_*/runs/
pd/*/ol_*/*.log

# FPGA emulation generated artifacts
fpga-emul/vivado_proj/
fpga-emul/obj_dir_*/
fpga-emul/*.bit
