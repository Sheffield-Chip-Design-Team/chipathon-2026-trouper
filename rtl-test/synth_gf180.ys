# synth_gf180.ys — Trial synthesis: mimo_rx_top → GF180MCU mcu7t5v0 TT 3.3V 25C
#
# Blackboxed:
#   picorv32       — external PicoRV32 CPU core (IP not included)
#   picorv32_wrap  — contains 4 kB CPU SRAM; blackboxed to avoid FF explosion
#
# Behavioural models synthesised as FF arrays (area over-estimate, noted):
#   sram0_mem / sram1_mem in mimo_rx_top — two 512×8 frontend buffer SRAMs
#   In layout these become gf180mcu_fd_ip_sram__sram512x8m8wm1 macros.

# ---- Read RTL ---------------------------------------------------------------
read_verilog -sv /work/sd_decimator.v
read_verilog -sv /work/dc_removal.v
read_verilog -sv /work/frontend_buf_ctrl.v
read_verilog -sv /work/sc_detector.v
read_verilog -sv /work/energy_meas_coarse.v
read_verilog -sv /work/training_acc.v
read_verilog -sv /work/packet_ctrl_fsm.v
read_verilog -sv /work/mrc_combiner.v
read_verilog -sv /work/sd_remod.v
read_verilog -sv /work/irq_ctrl.v
read_verilog -sv /work/reg_bank.v
read_verilog -sv /work/ahb_lite_bus.v
read_verilog -sv /work/spi_master.v
read_verilog -sv /work/spi_slave.v
read_verilog -sv /work/mimo_rx_top.v

# ---- Blackboxes -------------------------------------------------------------
read_verilog    /work/picorv32_stub.v
read_verilog -sv /work/picorv32_wrap_bb.v
read_verilog    /work/sram512x8_bb.v
read_verilog    /work/weight_gen_bb.v

# ---- Elaborate --------------------------------------------------------------
hierarchy -check -top mimo_rx_top

# ---- Synthesise -------------------------------------------------------------
# Keep hierarchy for a tractable trial synthesis run inside OSIC Docker.
synth -top mimo_rx_top

# ---- Technology mapping -----------------------------------------------------
dfflibmap -liberty /foss/pdks/gf180mcuD/libs.ref/gf180mcu_fd_sc_mcu7t5v0/lib/gf180mcu_fd_sc_mcu7t5v0__tt_025C_3v30.lib

abc -liberty /foss/pdks/gf180mcuD/libs.ref/gf180mcu_fd_sc_mcu7t5v0/lib/gf180mcu_fd_sc_mcu7t5v0__tt_025C_3v30.lib -D 31250

# ---- Clean-up and report ----------------------------------------------------
opt_clean -purge

stat -liberty /foss/pdks/gf180mcuD/libs.ref/gf180mcu_fd_sc_mcu7t5v0/lib/gf180mcu_fd_sc_mcu7t5v0__tt_025C_3v30.lib

tee -o /work/out/stat.txt stat -liberty /foss/pdks/gf180mcuD/libs.ref/gf180mcu_fd_sc_mcu7t5v0/lib/gf180mcu_fd_sc_mcu7t5v0__tt_025C_3v30.lib
write_verilog -noattr /work/out/netlist_mimo_rx_top.v
