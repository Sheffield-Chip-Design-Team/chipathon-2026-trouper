# synth_gf180.ys — Trial synthesis: trouper_top → GF180MCU mcu7t5v0 TT 3.3V 25C
#
# Canonical top-level RTL: trouper_top.
# mimo_rx_top is deprecated and retained only for archived comparisons.

# ---- Read RTL ---------------------------------------------------------------
read_verilog -sv /work/rtl/sd_cic_chan.v
read_verilog -sv /work/rtl/sd_decim_2ch_cic_only.v
read_verilog -sv /work/rtl/sd_decimator_cic_only.v
read_verilog -sv /work/rtl/dc_removal.v
read_verilog -sv /work/rtl/sc_detector.v
read_verilog -sv /work/rtl/training_acc.v
read_verilog -sv /work/rtl/packet_ctrl_fsm.v
read_verilog -sv /work/rtl/psram_buf_ctrl.v
read_verilog -sv /work/rtl/mrc_combiner.v
read_verilog -sv /work/rtl/sd_remod.v
read_verilog -sv /work/rtl/reg_bank.v
read_verilog -sv /work/rtl/spi_slave.v
read_verilog -sv /work/rtl/trouper_top.v

# ---- Elaborate --------------------------------------------------------------
hierarchy -check -top trouper_top

# ---- Synthesise -------------------------------------------------------------
# Keep hierarchy for a tractable trial synthesis run inside OSIC Docker.
synth -top trouper_top

# ---- Technology mapping -----------------------------------------------------
dfflibmap -liberty /foss/pdks/gf180mcuD/libs.ref/gf180mcu_fd_sc_mcu7t5v0/lib/gf180mcu_fd_sc_mcu7t5v0__tt_025C_3v30.lib

abc -liberty /foss/pdks/gf180mcuD/libs.ref/gf180mcu_fd_sc_mcu7t5v0/lib/gf180mcu_fd_sc_mcu7t5v0__tt_025C_3v30.lib -D 31250

# ---- Clean-up and report ----------------------------------------------------
opt_clean -purge

stat -liberty /foss/pdks/gf180mcuD/libs.ref/gf180mcu_fd_sc_mcu7t5v0/lib/gf180mcu_fd_sc_mcu7t5v0__tt_025C_3v30.lib

tee -o /work/out/stat.txt stat -liberty /foss/pdks/gf180mcuD/libs.ref/gf180mcu_fd_sc_mcu7t5v0/lib/gf180mcu_fd_sc_mcu7t5v0__tt_025C_3v30.lib
write_verilog -noattr /work/out/netlist_trouper_top.v
