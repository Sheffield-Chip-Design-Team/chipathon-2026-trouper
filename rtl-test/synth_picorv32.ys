# synth_picorv32.ys — Synthesise PicoRV32 RV32IM → GF180MCU mcu7t5v0 TT 3.3V 25C
# Parameters match integration spec:
#   ENABLE_MUL=1, ENABLE_DIV=1, ENABLE_IRQ=1, ENABLE_FAST_MUL=0 (iterative, saves gates)
# Target: 16 MHz (62500 ps) — retargetted from 32 MHz after SS-corner timing failure
#
# chparam must be set BEFORE synth/hierarchy so submodule pruning sees the
# correct parameter values and retains picorv32_pcpi_mul / _div.

read_verilog /work/picorv32_ip/picorv32.v

chparam -set ENABLE_MUL 1 picorv32
chparam -set ENABLE_DIV 1 picorv32
chparam -set ENABLE_IRQ 1 picorv32
chparam -set ENABLE_FAST_MUL 0 picorv32
chparam -set ENABLE_COUNTERS 1 picorv32
chparam -set ENABLE_REGS_DUALPORT 1 picorv32

synth -top picorv32

dfflibmap -liberty /foss/pdks/gf180mcuD/libs.ref/gf180mcu_fd_sc_mcu7t5v0/lib/gf180mcu_fd_sc_mcu7t5v0__tt_025C_3v30.lib

abc -liberty /foss/pdks/gf180mcuD/libs.ref/gf180mcu_fd_sc_mcu7t5v0/lib/gf180mcu_fd_sc_mcu7t5v0__tt_025C_3v30.lib -D 62500

opt_clean -purge

tee -o /work/out/stat_picorv32.txt stat -liberty /foss/pdks/gf180mcuD/libs.ref/gf180mcu_fd_sc_mcu7t5v0/lib/gf180mcu_fd_sc_mcu7t5v0__tt_025C_3v30.lib
write_verilog -noattr /work/out/netlist_picorv32.v
