create_clock -name clk -period 31.25 [get_ports clk]
set_input_delay -max 2.0 -clock clk [get_ports {addr wdata we re gpio_in cpu_sram_status buf_mode buf_valid sram0_bist_pass sram1_bist_pass buf_freeze buf_wr_ptr rx_gain_active_0 rx_gain_active_1 rx_gain_active_2 rx_gain_active_3 rx_gain_pending rx_gain_owner rx_gain_error active_mode_rb active_antenna_en_rb packet_active packet_phase training_done_rb w_pending_rb w_valid_rb w_missed_rb irq_set energy_0 energy_1 energy_2 energy_3 corr_mag_0 corr_mag_1 corr_mag_2 corr_mag_3 sc_stat training_armed n_acc z_shift c_pool_i c_pool_q cfo_diag z0_i z0_q z1_i z1_q z2_i z2_q z3_i z3_q sc_hit_dbg sc_hit_count_dbg sc_lock_dbg sc_first_hit_dbg sc_lock_snap_dbg sram_dump_done sram_dump_data sigma2_valid sigma2_hw_0 sigma2_hw_1 sigma2_hw_2 sigma2_hw_3 psram_status_rb psram_pkt_bytes psram_rd_offset}]
set_input_delay -min 1.0 -clock clk [get_ports {addr wdata we re gpio_in cpu_sram_status buf_mode buf_valid sram0_bist_pass sram1_bist_pass buf_freeze buf_wr_ptr rx_gain_active_0 rx_gain_active_1 rx_gain_active_2 rx_gain_active_3 rx_gain_pending rx_gain_owner rx_gain_error active_mode_rb active_antenna_en_rb packet_active packet_phase training_done_rb w_pending_rb w_valid_rb w_missed_rb irq_set energy_0 energy_1 energy_2 energy_3 corr_mag_0 corr_mag_1 corr_mag_2 corr_mag_3 sc_stat training_armed n_acc z_shift c_pool_i c_pool_q cfo_diag z0_i z0_q z1_i z1_q z2_i z2_q z3_i z3_q sc_hit_dbg sc_hit_count_dbg sc_lock_dbg sc_first_hit_dbg sc_lock_snap_dbg sram_dump_done sram_dump_data sigma2_valid sigma2_hw_0 sigma2_hw_1 sigma2_hw_2 sigma2_hw_3 psram_status_rb psram_pkt_bytes psram_rd_offset}]
set_output_delay -max 2.0 -clock clk [all_outputs]
set_output_delay -min 0.0 -clock clk [all_outputs]
set_clock_uncertainty 0.25 [get_clocks clk]
set_false_path -from [get_ports rst_n]
